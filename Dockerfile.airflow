FROM apache/airflow:2.7.3

USER root

# Install OpenJDK 11 JRE and procps for PySpark
RUN apt-get update && \
    apt-get install -y --no-install-recommends openjdk-11-jre-headless procps && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# Set JAVA_HOME and update PATH
ENV JAVA_HOME=/usr/lib/jvm/java-11-openjdk-amd64
ENV PATH="${JAVA_HOME}/bin:${PATH}"

# Ensure ivy cache directory is accessible
RUN mkdir -p /home/airflow/.ivy2/cache /home/airflow/.ivy2/jars /tmp/.ivy2 && \
    chown -R 50000:0 /home/airflow/.ivy2 /tmp/.ivy2 && \
    chmod -R 777 /home/airflow/.ivy2 /tmp/.ivy2

USER airflow

# Install PySpark, Kafka, unidecode, psycopg2, requests
RUN pip install --no-cache-dir \
    "apache-airflow==${AIRFLOW_VERSION}" \
    pyspark==3.5.0 \
    kafka-python==2.0.2 \
    unidecode==1.3.7 \
    psycopg2-binary==2.9.9 \
    requests==2.31.0
